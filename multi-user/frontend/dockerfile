FROM node:24-slim AS builder

WORKDIR /app
COPY . .

RUN npm install
RUN npm run build

FROM node:23-alpine-slim AS runner

WORKDIR /app

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package*.json ./

RUN npm install --omit=dev

EXPOSE 4173

CMD ["npm", "run", "preview", "--", "--host"]
